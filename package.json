{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:persistence && npm run test:email && npm run test:api && npm run test:export && npm run test:sharing && npm run test:payments && npm run test:bulk && npm run test:footer && npm run test:receipt && npm run test:customer && npm run test:documents && npm run test:sync && npm run test:migration:unit && npm run test:gst && npm run test:help && npm run test:accessibility",
    "test:persistence": "tsx --test tests/persistenceRegression.test.ts",
    "test:email": "tsx --test tests/gmailSmtpProvider.test.ts",
    "test:api": "tsx --test tests/emailApiRoute.test.ts tests/secretScan.test.ts",
    "test:export": "tsx --test tests/documentExportRegression.test.ts",
    "test:sharing": "tsx --test tests/documentShareService.test.ts",
    "test:payments": "tsx --test tests/paymentTracking.test.ts",
    "test:bulk": "tsx --test tests/bulkDownload.test.ts",
    "test:footer": "tsx --test tests/footerLayout.test.ts",
    "test:receipt": "tsx --test tests/receiptOverlayRegression.test.ts",
    "test:customer": "tsx --test tests/customerExperienceRegression.test.ts",
    "test:documents": "tsx --test tests/documentPolishRegression.test.ts",
    "test:sync": "tsx --test tests/syncFeedbackRegression.test.ts tests/syncLifecycleRegression.test.ts",
    "test:migration:unit": "tsx --test tests/firestoreMigration.test.ts tests/normalizedOutbox.test.ts tests/trustedApplicationDataMigration.test.ts",
    "test:migration:emulator": "tsx --test tests/firestoreMigrationEmulator.test.ts",
    "test:firestore-rules": "tsx --test tests/firestoreRules.test.ts",
    "test:gst": "tsx --test tests/gstPlaceOfSupply.test.ts",
    "test:help": "tsx --test tests/helpContentRegression.test.ts",
    "test:accessibility": "tsx --test tests/uiAccessibilityRegression.test.ts",
    "emulators:migration": "firebase emulators:exec --only firestore --project billease-migration-test \"npm run test:migration:unit && npm run test:migration:emulator\"",
    "test:firebase": "firebase emulators:exec --only firestore --project billease-security-test \"npm run test:firestore-rules && npm run test:migration:emulator\"",
    "security:secrets": "tsx scripts/secretScan.ts",
    "migration:backup": "tsx scripts/firestoreMigration.ts backup",
    "migration:dry-run": "tsx scripts/firestoreMigration.ts migrate",
    "migration:verify": "tsx scripts/firestoreMigration.ts verify",
    "migration:restore": "tsx scripts/firestoreMigration.ts restore",
    "migration:rollback": "tsx scripts/firestoreMigration.ts rollback"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "firebase": "^12.13.0",
    "firebase-admin": "13.10.0",
    "formidable": "^3.5.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/formidable": "^3.5.1",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
